
/* Define Nextflow configuration settings for SCALPEL pipeline execution */
/* ===================================================================== */

/* -> Processes */

/* Enter here the desired Nextflow parameters for execution (see https://www.nextflow.io/docs/latest/index.html)*/

params {
    // General parameters
    workDir = './work'          // Directory for Nextflow work files
    process.executor = 'local'  // Default executor, can be overridden in the executor block
    process.queue = 'default'   // Default queue, can be overridden in the executor block

    //=====1. Specific parameters for SCALPEL pipeline====
    outputDir = "./results" // Directory for output files

    // 1a. Reads:
    samplesheet = null
    sequencing = null
    barcodes = null
    clusters = null

    // 1b. Annotation:
    transcriptome = null
    gtf = null
    ipdb = null

    // 1c. Thresholds:
    dt_threshold = 600
    de_threshold = 30
    ip_threshold = 60
    gene_fraction = "98%"
    binsize = 20
    subsample = 1
    help = null

    // Cells per em_algorithm task. cells_splitting produces one file per barcode, so
    // without batching this stage spawns one Nextflow task per cell.
    em_batch = 500

    // Added to each transcript's TPM before averaging across samples, guarding the
    // within-gene division in quantification_processing.R. 1 is upstream SCALPEL's
    // value, where it was hardcoded rather than exposed; exposing it changes nothing
    // by default. Lowering it sharpens the isoform prior for lowly-expressed genes
    // (at 0.1, genes with a near-uniform prior fall from 28.9% to 18.6% on the B32
    // pilot) but makes the EM trust salmon's zeros more, which is its weakest output
    // here at ~20% mapping of 3'-tagged reads against full-length transcripts.
    tpm_pseudocount = 1

    // Interpreter for src/dge_generation.py. It needs numpy, scipy, pandas and anndata,
    // which the R/samtools scalpelEnv does not carry, so point this at an environment
    // that does (e.g. --python /path/to/env/bin/python3, or in a site config).
    python = "python3"

    //=====2. Running parameters=====
    params.cpus = 16           /* Adjust as needed */
    params.memory = 40.GB     /* Adjust as needed */
}


/* global parameters for execution */
executor {
    name = 'local'
    cpus = params.cpus
    memory = params.memory
    maxForks = params.cpus
}



/* Parameters by process */
process {
    withLabel: big_rec {
        cpus = 3
        memory = params.memory
        time = '4h'
    }

    withLabel: small_rec {
        cpus = 2
        memory = {
            def base = (params.memory.toMega() / params.cpus).toInteger()
            def scaled = base * Math.pow(2, task.attempt - 1)
            Math.max(scaled.toInteger(), 2048).MB
        }
        maxForks = params.cpus
        maxRetries = 3
        time = '4h'
        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
    }
}


/* Apptainer support */
// If using Apptainer, insert to runOption SCALPEL local path ; Ex: runOptions = "--bind PATH_TO_SCALPEL_REPO:PATH_TO_SCALPEL_REPO"
apptainer {
    enabled = true
    autoMounts = true
    runOptions = "--bind "
}
